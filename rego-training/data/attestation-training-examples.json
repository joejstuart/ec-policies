    },
    "task_started": {
      "path": "task.startedOn",
      "type": "string",
      "description": "ISO 8601 timestamp when task started"
    },
    "metadata": {
      "path": "attestation.statement.predicate.metadata",
      "type": "object",
      "description": "Build metadata"
    },
    "build_finished": {
      "path": "attestation.statement.predicate.metadata.buildFinishedOn",
      "type": "string",
      "description": "ISO 8601 timestamp when build finished"
    },
    "build_started": {
      "path": "attestation.statement.predicate.metadata.buildStartedOn",
      "type": "string",
      "description": "ISO 8601 timestamp when build started"
    }
  }
}
